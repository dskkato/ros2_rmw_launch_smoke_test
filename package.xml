<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rmw_launch_smoke_test</name>
  <version>0.1.0</version>
  <description>Minimal launch_testing pub/sub smoke test for ROS 2 RMW implementations.</description>
  <maintainer email="daisuke.kato@example.com">Daisuke Kato</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>rmw_fastrtps_cpp</test_depend>
  <test_depend>rmw_cyclonedds_cpp</test_depend>
  <test_depend>rmw_zenoh_cpp</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
